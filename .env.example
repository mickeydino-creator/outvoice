# Supabase (public — safe to expose in the frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend API key is NOT set here. It must only be configured as a Supabase
# Edge Function secret so it never reaches the frontend:
#   supabase secrets set RESEND_API_KEY=your-resend-api-key
